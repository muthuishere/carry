  "homepage": "https://github.com/muthuishere/carry#readme",
  "bugs": { "url": "https://github.com/muthuishere/carry/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/muthuishere/carry.git", "directory": "sdk/js" },
